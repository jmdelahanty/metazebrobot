[Unit]
Description=MetaZebrobot Read-Only API
After=network.target

[Service]
Type=simple
User=delahantyj
Group=ahrens
WorkingDirectory=/home/delahantyj@hhmi.org/gitrepos/metazebrobot
Environment=METAZEBROBOT_DB_PATH=/nvme1/zebrobot.db
Environment=PATH=/home/delahantyj@hhmi.org/.pixi/bin:/usr/bin:/bin
ExecStart=/home/delahantyj@hhmi.org/.pixi/bin/pixi run python -m metazebrobot.api_server --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
